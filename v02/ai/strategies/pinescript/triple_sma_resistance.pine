//@version=5
// ============================================================================
// Triple SMA 정배열 + 저항 돌파 복합 전략 (중급형)
// - 기본형 + 직전 N봉 내 고점(저항선) 자동 탐지
// - 정배열 + 저항 돌파 + 거래량 급증 → 강한 매수 시그널
// - 목표가: 직전 큰 윗꼬리 꼭짓점 자동 설정
// - 손절: 진입 캔들 저점
// ============================================================================
strategy("Triple SMA 저항 돌파 (중급형)", shorttitle="TriSMA_Resist", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     initial_capital=10000000, commission_type=strategy.commission.percent,
     commission_value=0.015, slippage=1)

// ── Inputs ──────────────────────────────────────────────────────────────────
shortLen     = input.int(5,    "단기 SMA 길이",       minval=1)
midLen       = input.int(25,   "중기 SMA 길이",       minval=1)
longLen      = input.int(75,   "장기 SMA 길이",       minval=1)
resistLookback = input.int(50, "저항선 탐색 기간",     minval=10, maxval=200)
volMultiplier  = input.float(1.5, "거래량 급증 배수", minval=1.0, step=0.1)
wickRatio      = input.float(0.6, "윗꼬리 비율 기준", minval=0.3, step=0.1,
     tooltip="캔들 전체 대비 윗꼬리 비율이 이 값 이상이면 큰 윗꼬리 캔들로 판단")

// ── SMA 계산 ────────────────────────────────────────────────────────────────
smaShort = ta.sma(close, shortLen)
smaMid   = ta.sma(close, midLen)
smaLong  = ta.sma(close, longLen)

// ── 정배열 판별 ─────────────────────────────────────────────────────────────
longRising     = smaLong > smaLong[1]
isBullishAlign = smaShort > smaMid and smaMid > smaLong and longRising
isBearishAlign = smaShort < smaMid and smaMid < smaLong and smaLong < smaLong[1]

// ── 배경색 ──────────────────────────────────────────────────────────────────
bgColor = isBullishAlign ? color.new(color.green, 90) :
          isBearishAlign ? color.new(color.red, 90) :
          color.new(color.gray, 95)
bgcolor(bgColor, title="배열 배경")

// ── 저항선 탐지 (직전 N봉 내 고점 기반) ─────────────────────────────────────
// 과거 봉들의 고점(몸통 고점) 중 최고치를 저항선으로 사용
bodyHigh      = math.max(open, close)
resistLevel   = ta.highest(bodyHigh, resistLookback)

// 저항선 돌파: 현재 종가가 저항선 위로 올라옴
resistBreak = close > resistLevel[1] and close[1] <= resistLevel[2]

// ── 거래량 급증 확인 ────────────────────────────────────────────────────────
volSMA       = ta.sma(volume, 20)
volumeSurge  = volume > volSMA * volMultiplier

// ── 목표가: 직전 큰 윗꼬리 캔들의 꼭짓점 ───────────────────────────────────
candleRange  = high - low
upperWick    = high - math.max(open, close)
isLongWick   = candleRange > 0 ? (upperWick / candleRange >= wickRatio) : false

// 최근 큰 윗꼬리 캔들의 고점을 목표가로 저장
var float targetPrice = na
for i = 1 to resistLookback
    if isLongWick[i]
        targetPrice := high[i]
        break

// ── 매수 조건 ───────────────────────────────────────────────────────────────
// 기본 매수: 정배열 + SMA5 돌파
priceCrossAboveSMA5 = ta.crossover(close, smaShort)
basicBuy = isBullishAlign and priceCrossAboveSMA5

// 강한 매수: 정배열 + 저항 돌파 + 거래량 급증
strongBuy = isBullishAlign and resistBreak and volumeSurge

buySignal = basicBuy or strongBuy

// ── 매도 조건 ───────────────────────────────────────────────────────────────
bearishBreakMid = close < smaMid and close < open
deathCross      = ta.crossunder(smaShort, smaMid)
hitTarget       = not na(targetPrice) and high >= targetPrice

sellSignal = bearishBreakMid or deathCross or hitTarget

// ── 손절: 진입 캔들 최저점 ──────────────────────────────────────────────────
var float stopLossPrice = na
var bool  isStrongEntry = false

if buySignal and strategy.position_size == 0
    stopLossPrice := low
    isStrongEntry := strongBuy

// ── 전략 실행 ───────────────────────────────────────────────────────────────
if buySignal and strategy.position_size == 0
    lbl = strongBuy ? "강매수" : "매수"
    strategy.entry(lbl, strategy.long)

if strategy.position_size > 0
    strategy.exit("손절", stop=stopLossPrice)
    if sellSignal
        comment = hitTarget ? "목표달성" : "청산"
        strategy.close_all(comment=comment)

// ── 시그널 표시 ─────────────────────────────────────────────────────────────
plotshape(strongBuy and strategy.position_size == 0, title="강매수",
     style=shape.triangleup, location=location.belowbar,
     color=color.lime, size=size.normal, text="STRONG")

plotshape(basicBuy and not strongBuy and strategy.position_size == 0, title="매수",
     style=shape.triangleup, location=location.belowbar,
     color=color.green, size=size.small, text="BUY")

plotshape(sellSignal and strategy.position_size > 0, title="매도",
     style=shape.triangledown, location=location.abovebar,
     color=color.red, size=size.small, text="SELL")

plotshape(hitTarget and strategy.position_size > 0, title="목표달성",
     style=shape.flag, location=location.abovebar,
     color=color.orange, size=size.small, text="TARGET")

// ── SMA 플롯 ────────────────────────────────────────────────────────────────
plot(smaShort, "SMA 5",  color=color.blue,   linewidth=2)
plot(smaMid,   "SMA 25", color=color.orange,  linewidth=2)
plot(smaLong,  "SMA 75", color=color.black,   linewidth=2)

// ── 저항선 / 목표가 / 손절라인 표시 ─────────────────────────────────────────
plot(resistLevel, "저항선", color=color.new(color.purple, 50),
     style=plot.style_stepline, linewidth=1)

plot(strategy.position_size > 0 and not na(targetPrice) ? targetPrice : na,
     "목표가", color=color.new(color.orange, 30),
     style=plot.style_linebr, linewidth=2)

plot(strategy.position_size > 0 ? stopLossPrice : na, "손절라인",
     color=color.red, style=plot.style_linebr, linewidth=1)

// ── 정보 테이블 ─────────────────────────────────────────────────────────────
var table infoTbl = table.new(position.top_right, 2, 4, bgcolor=color.new(color.white, 80))
if barstate.islast
    table.cell(infoTbl, 0, 0, "상태", text_color=color.black, text_size=size.small)
    status = isBullishAlign ? "정배열" : isBearishAlign ? "역배열" : "꼬임"
    statusClr = isBullishAlign ? color.green : isBearishAlign ? color.red : color.gray
    table.cell(infoTbl, 1, 0, status, text_color=statusClr, text_size=size.small)

    table.cell(infoTbl, 0, 1, "저항선", text_color=color.black, text_size=size.small)
    table.cell(infoTbl, 1, 1, str.tostring(resistLevel, "#.##"), text_color=color.purple, text_size=size.small)

    table.cell(infoTbl, 0, 2, "목표가", text_color=color.black, text_size=size.small)
    table.cell(infoTbl, 1, 2, str.tostring(targetPrice, "#.##"), text_color=color.orange, text_size=size.small)

    table.cell(infoTbl, 0, 3, "거래량", text_color=color.black, text_size=size.small)
    volStatus = volumeSurge ? "급증" : "보통"
    volClr = volumeSurge ? color.green : color.gray
    table.cell(infoTbl, 1, 3, volStatus, text_color=volClr, text_size=size.small)
